# ==============================================================================
# MICRO-INVESTING ENGINE - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual API keys
# Command: cp .env.template .env
# ==============================================================================

# ==============================================================================
# REQUIRED FOR ALL STRATEGIES
# ==============================================================================

# Alpaca Paper Trading Keys (for testing with fake money)
# Future brokers can be added, but for now this repo works only with Alpaca.
# Get at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# ==============================================================================
# OPTIONAL: LIVE TRADING (real money)
# ==============================================================================

# Alpaca Live Trading Keys (SEPARATE from paper keys)
# Get at: https://app.alpaca.markets/dashboard/overview
# ALPACA_LIVE_API_KEY=your_live_api_key_here
# ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here

# ==============================================================================
# OPTIONAL: CREDIT CARD REWARDS STRATEGY
# ==============================================================================

# Card Caddie API (only needed for credit_card_rewards strategy)
# Get at: https://thecardcaddie.com/profile
# THECARDCADDIE_API_KEY=cc_xxxxxxxxxxxxx

# ==============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ==============================================================================

# Gmail SMTP (for email alerts)
# Get app password at: https://myaccount.google.com/apppasswords
# EMAIL_TO=your@email.com
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_16_digit_app_password